# Copy this file to `.env` and fill in the values.
# Vite bakes these in at BUILD time: after changing them run
#   npm run build && npx cap sync android
# and run the app again from Android Studio.

# Your API host: just https:// + domain. No trailing slash, and do NOT include /api.
# The app calls {VITE_API_BASE_URL}/api/Machine/public/all-machines
# Must be HTTPS (Android blocks plain HTTP).
VITE_API_BASE_URL=https://api.your-domain.com

# Optional: only if your API needs an `x-api-key` header.
VITE_API_KEY=

# Machines loaded per page (the "Load more" button fetches the next page).
VITE_PAGE_SIZE=20

# Google Maps (dashboard map). Get a key at https://console.cloud.google.com/google/maps-apis
# Enable "Maps JavaScript API". Leave empty to use the free OpenStreetMap map instead.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud > Map Management). DEMO_MAP_ID is fine for testing.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Map tiles (fallback map): OpenStreetMap, with the OSM France server as backup for failed tiles.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_FALLBACK_URL=https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Map centre used until the user taps "use my location".
VITE_DEFAULT_LAT=21.1458
VITE_DEFAULT_LNG=79.0882
VITE_DEFAULT_LOCATION_LABEL=Nagpur
