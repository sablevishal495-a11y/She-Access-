# Copy this file to `.env` (or `.env.production`) and fill in the values.
# Vite inlines these at BUILD time, so rebuild the app + `npx cap sync android` after changing them.

# Backend base URL. Leave EMPTY to run in demo mode with built-in placeholder data.
# Use HTTPS in production (Android blocks plain HTTP by default).
VITE_API_BASE_URL=

# API key sent as the `x-api-key` header with every request.
# NOTE: anything bundled into a mobile app can be extracted, so only put a *public / restricted* key here.
VITE_API_KEY=

# Set true only when using the included development backend, which has sample
# machines and a fixed OTP. Leave false for a real SMS / inventory backend.
VITE_DEMO_MODE=false
VITE_DEMO_OTP=123456

# Keyless Humanitarian OpenStreetMap tiles, hosted by OpenStreetMap France.
# For production traffic follow the tile provider's policy or use your own provider.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors, tiles by HOT / OSM France

# Used only when the user does not grant location permission.
VITE_DEFAULT_LAT=28.6139
VITE_DEFAULT_LNG=77.2090
VITE_DEFAULT_LOCATION_LABEL=New Delhi

# How far to search for machines (km).
VITE_SEARCH_RADIUS_KM=5
